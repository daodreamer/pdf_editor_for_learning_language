// Generated by CMake from linguapdf.rc.in.
// First icon resource: used by Explorer, the taskbar and Alt+Tab for LinguaPDF.exe.
#include <winver.h>
IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/assets/icons/linguapdf.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LinguaPDF contributors\0"
            VALUE "FileDescription", "LinguaPDF\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "LinguaPDF\0"
            VALUE "LegalCopyright", "MIT License. Copyright (c) 2026 LinguaPDF contributors\0"
            VALUE "OriginalFilename", "LinguaPDF.exe\0"
            VALUE "ProductName", "LinguaPDF\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
